[TEMPLATE]
# Токен бота от @BotFather (обязательно)
WB_BOT_TOKEN=123456:ABC-DEF...

# --- LLM ---
# mock (демо, без ключей) | yandex | openai
LLM_PROVIDER=mock
# YandexGPT
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_MODEL=yandexgpt-lite
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Резервные провайдеры через запятую (порядок попыток при сбое основного)
LLM_FALLBACKS=mock
# Сколько раз переспрашивать LLM при невалидном JSON
LLM_MAX_RETRIES=2

# --- Парсинг и демо ---
# 1 = демо-режим (отзывы выдуманные, сеть не нужна) | 0 = реальный парсинг WB
WB_DEMO_MODE=1
MAX_REVIEWS=50
# TTL кэша отзывов по артикулу (секунды)
ANALYSIS_CACHE_TTL=300

# Минимальный интервал между сообщениями пользователя (секунды)
THROTTLE_MIN_INTERVAL=0.7
