# Токен бота от @BotFather (обязательно)
WB_BOT_TOKEN=123456:ABC-DEF...

# Провайдер LLM: mock (демо, без ключей) | yandex | openai
LLM_PROVIDER=mock

# --- YandexGPT (если LLM_PROVIDER=yandex) ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_MODEL=yandexgpt-lite

# --- OpenAI (если LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 1 = демо-режим (парсер отзывов не ходит в сеть)
WB_DEMO_MODE=0

# Сколько отзывов анализировать (по ТЗ — 50)
MAX_REVIEWS=50
